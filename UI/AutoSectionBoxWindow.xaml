<Window x:Class="AutoPileCap.UI.AutoSectionBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Section Box" Height="250" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- View Selection -->
        <TextBlock Text="View:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"/>
        <ComboBox x:Name="cmbViews" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" IsEditable="True" ToolTip="Select existing 3D view or type a new name"/>
        
        <TextBlock x:Name="txtViewWarning" Foreground="Red" Grid.Row="1" Grid.Column="1" Margin="0,-5,0,10" Visibility="Collapsed"/>

        <!-- Size / Buffer -->
        <TextBlock Text="Buffer (mm):" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,0,10,10"/>
        <TextBox x:Name="txtBuffer" Grid.Row="2" Grid.Column="1" Text="300" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <!-- View Template -->
        <TextBlock Text="Assign View Template:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="0,0,10,10"/>
        <ComboBox x:Name="cmbTemplates" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" DisplayMemberPath="Name"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Height="25" Margin="0,0,10,0" Click="BtnOK_Click" Background="#0078D7" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancel" Width="80" Height="25" Click="BtnCancel_Click" Background="White" BorderBrush="#CCCCCC"/>
        </StackPanel>
    </Grid>
</Window>
