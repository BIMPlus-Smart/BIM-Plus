<Window x:Class="AutoPileCap.UI.BeamRebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Plus — Beam Bar Pro"
        Height="860" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="12">
    <!-- Resources -->
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#0D6EFD"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#E2E8F0"/>

        <!-- ToggleSwitch Style for CheckBoxes -->
        <Style TargetType="CheckBox" x:Key="ToggleSwitch">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Width="36" Height="20" CornerRadius="10" Background="#CBD5E1">
                            <Ellipse x:Name="thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D6EFD"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/> <!-- Header -->
            <RowDefinition Height="*"/>  <!-- Main Body -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Grid Grid.Row="0" Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo Area -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="BIM" FontSize="24" FontWeight="Black" Foreground="#0F172A"/>
                    <TextBlock Text="Plus" FontSize="24" FontWeight="Black" Foreground="#0D6EFD"/>
                    <TextBlock Text="+" FontSize="24" FontWeight="Black" Foreground="#0D6EFD" Margin="2,0,0,0"/>
                </StackPanel>
                <TextBlock Text="|" FontSize="20" Foreground="#CBD5E1" Margin="12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Beam Bar Pro" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Full 3D Reinforcement Cage Generator" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/> <!-- Left Nav -->
                <ColumnDefinition Width="380"/> <!-- Controls -->
                <ColumnDefinition Width="*"/>   <!-- Canvas -->
                <ColumnDefinition Width="120"/> <!-- Shape Browser -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAV -->
            <Border Grid.Column="0" Background="#FFFFFF" Margin="10,0,10,16" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <StackPanel Margin="0,20,0,0">
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,20">
                        <TextBlock Text="Better Design" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="Smarter BIM" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="BIM" FontSize="12" FontWeight="Black" Foreground="#0F172A"/>
                            <TextBlock Text="Plus+" FontSize="12" FontWeight="Black" Foreground="#0D6EFD"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTROLS PANEL -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="16" Margin="0,0,16,16" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Element selector -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Beam:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <TextBlock x:Name="txtSelectedCount" Text="0 Columns Selected" Foreground="#0F172A" VerticalAlignment="Center" Padding="10,0"/>
                        </Border>
                        <Button x:Name="BtnSelectBeam" Grid.Column="2" Content="⌖ Pick Element" Click="BtnSelectBeam_Click" Background="#0D6EFD" Foreground="White" Width="100" Height="32" FontWeight="Bold" BorderThickness="0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Scroll Form -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            
                            <!-- 1 Crank Rebar -->
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#0D6EFD">
                                            <TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Crank Rebar" Foreground="#0F172A" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="10,0"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                            <Label Content="Top Crank:" Padding="0,0,0,4"/>
                                            <ComboBox x:Name="cmbTopCrank" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                                            <Label Content="Bottom Crank:" Padding="0,0,0,4"/>
                                            <ComboBox x:Name="cmbBottomCrank" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,8"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- 2 Vertical Rebar -->
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#0D6EFD">
                                            <TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Vertical Rebar" Foreground="#0F172A" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="10,0"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                            <Label Content="Main Bar Size:" Padding="0,0,0,4"/>
                                            <ComboBox x:Name="cmbVerticalBarType" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                            <Label Content="Quantity Width (B):" Padding="0,0,0,4"/>
                                            <TextBox x:Name="txtNx" Text="3" TextChanged="TxtNxNy_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                                            <Label Content="Quantity Depth (H):" Padding="0,0,0,4"/>
                                            <TextBox x:Name="txtNy" Text="3" TextChanged="TxtNxNy_TextChanged"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                                            <Label Content="Top Hook:" Padding="0,0,0,4"/>
                                            <ComboBox x:Name="cmbTopHook" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8">
                                            <Label Content="Bottom Hook:" Padding="0,0,0,4"/>
                                            <ComboBox x:Name="cmbBottomHook" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- 3 Ties & Stirrups -->
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#0D6EFD">
                                            <TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Ties &amp; Stirrups" Foreground="#0F172A" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="10,0"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                            <Label Content="Tie Bar Size:" Padding="0,0,0,4"/>
                                            <ComboBox x:Name="cmbTieBarType" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                            <Label Content="Hook Type:" Padding="0,0,0,4"/>
                                            <ComboBox x:Name="cmbTieHookType" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                            <Label Content="Rebar Shape:" Padding="0,0,0,4"/>
                                            <ComboBox x:Name="cmbTieShape" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                                            <Label Content="Spacing (mm):" Padding="0,0,0,4"/>
                                            <TextBox x:Name="txtTieSpacing" Text="150"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                            <CheckBox x:Name="chkInnerTies" Content="Add Inner Ties" IsChecked="True" Foreground="#1E293B" FontWeight="SemiBold" Checked="ChkInnerTies_Changed" Unchecked="ChkInnerTies_Changed"/>
                                        </StackPanel>
                                        <StackPanel x:Name="pnlInnerTies" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <Label Content="Inner Rebar Shape:" Padding="0,0,0,4"/>
                                                    <ComboBox x:Name="cmbInnerTieShape" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <Label Content="Inner Spacing (mm):" Padding="0,0,0,4"/>
                                                    <TextBox x:Name="txtInnerTieSpacing" Text="150"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- 4 Splice & Dowels -->
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#0D6EFD">
                                            <TextBlock Text="4" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Splice &amp; Dowels" Foreground="#0F172A" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="10,0"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                            <Label Content="Lap Splice Length (x d):" Padding="0,0,0,4"/>
                                            <TextBox x:Name="txtLapFactor" Text="40"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <CheckBox x:Name="chkDowels" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                                                <TextBlock Text="Extend Dowels" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Generate Button -->
                    <Button x:Name="btnGenerate" Grid.Row="2" Content="⚙ GENERATE &gt;" Click="BtnGenerate_Click" Height="40" Background="#0D6EFD" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,16,0,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- CANVAS (Right Panel) -->
            <Grid Grid.Column="2" Margin="0,0,10,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Canvas Buttons -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" HorizontalAlignment="Left">
                    <Button x:Name="BtnView3D" Content="3D VIEW" Width="100" Height="36" Background="#0D6EFD" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Tag="3D" Click="BtnViewMode_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="BtnViewTop" Content="TOP VIEW" Width="100" Height="36" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Tag="TOP" Click="BtnViewMode_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="BtnViewBot" Content="BOT VIEW" Width="100" Height="36" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Tag="BOT" Click="BtnViewMode_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="BtnViewSection" Content="SECTION" Width="100" Height="36" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Tag="SECTION" Click="BtnViewMode_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Canvas -->
                <Border x:Name="CanvasBorder" Grid.Row="1" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True" SizeChanged="CanvasBorder_SizeChanged" MouseWheel="Canvas_MouseWheel" MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp" MouseRightButtonDown="Canvas_MouseRightButtonDown">
                    <Canvas x:Name="DrawingCanvas" Background="Transparent" ClipToBounds="True"/>
                </Border>
            </Grid>

            <!-- SHAPE BROWSER (Right Panel) -->
            <Border Grid.Column="3" Background="#FFFFFF" Margin="0,0,10,16" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Background="#F1F5F9" CornerRadius="12,12,0,0" Padding="8">
                        <TextBlock Text="Rebar Shape Browser" FontSize="11" FontWeight="Bold" Foreground="#475569" TextAlignment="Center"/>
                    </Border>
                    
                    <ListBox x:Name="lstShapeBrowser" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedValuePath="Id">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="1" Margin="2" Padding="4" CornerRadius="4" Width="90" Height="90" Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Path Data="{Binding Geometry}" Stroke="#0F172A" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" TextAlignment="Center" FontSize="10" Foreground="#0F172A" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>


