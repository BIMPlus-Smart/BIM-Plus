<Window x:Class="AutoPileCap.UI.PartitionRebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Plus — Partition Rebar Pro"
        Height="840" Width="1340"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="12">
    <!-- Resources -->
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#0D6EFD"/>
        <SolidColorBrush x:Key="AccentHover" Color="#0B5ED7"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#F1F5F9"/>

        <!-- Modern Button Style -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="OutlineButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scope Radio Button Pill -->
        <Style TargetType="RadioButton" x:Key="ScopeRadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pillBorder" Background="Transparent" CornerRadius="6" Padding="14,6" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#0D6EFD"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/> <!-- Top Header -->
            <RowDefinition Height="Auto"/> <!-- KPI Cards -->
            <RowDefinition Height="Auto"/> <!-- Filter / Scope Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main Body (Sidebar + Data Grid) -->
            <RowDefinition Height="68"/> <!-- Bottom Action Bar -->
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER -->
        <Grid Grid.Row="0" Margin="20,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo Area -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="BIM" FontSize="24" FontWeight="Black" Foreground="#0F172A"/>
                    <TextBlock Text="Plus" FontSize="24" FontWeight="Black" Foreground="#0D6EFD"/>
                    <TextBlock Text="+" FontSize="24" FontWeight="Black" Foreground="#0D6EFD" Margin="2,0,0,0"/>
                </StackPanel>
                <TextBlock Text="|" FontSize="20" Foreground="#CBD5E1" Margin="12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Partition Rebar Pro" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Rebar Selection &amp; Partition Inspector" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </StackPanel>

            <!-- Right Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚙ Settings" Foreground="#475569" Margin="0,0,20,0" Cursor="Hand" MouseDown="Settings_Click"/>
                <TextBlock Text="? Help" Foreground="#475569" Cursor="Hand" MouseDown="Help_Click"/>
            </StackPanel>
        </Grid>

        <!-- 2. KPI / STATS SUMMARY CARDS -->
        <Grid Grid.Row="1" Margin="20,0,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Partitions -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Partitions Found" FontSize="11" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtKpiPartitions" Text="0 Partitions" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center">
                        <TextBlock Text="📑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Rebar Sets -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Rebar Elements / Sets" FontSize="11" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtKpiSets" Text="0 Sets" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F0FDF4" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center">
                        <TextBlock Text="🏗️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Bar Quantity -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Total Bar Quantity (incl. Sets)" FontSize="11" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtKpiBars" Text="0 Bars" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Selected Elements -->
            <Border Grid.Column="3" Background="#FFFFFF" CornerRadius="10" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Checked For Action" FontSize="11" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtKpiSelected" Text="0 Selected (0.0 kg)" FontSize="18" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center">
                        <TextBlock Text="🎯" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. SCOPE & FILTER TOOLBAR -->
        <Border Grid.Row="2" Background="#FFFFFF" Margin="20,0,20,12" CornerRadius="10" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Scope Selector -->
                    <ColumnDefinition Width="Auto"/> <!-- Refresh Button -->
                    <ColumnDefinition Width="*"/>    <!-- Search Box -->
                    <ColumnDefinition Width="Auto"/> <!-- View Mode -->
                </Grid.ColumnDefinitions>

                <!-- Scope Selector Segmented Control -->
                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Padding="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbScopeActiveView" Content="Active View" Style="{StaticResource ScopeRadioButton}" IsChecked="True" Checked="RbScope_Checked"/>
                        <RadioButton x:Name="RbScopeWholeModel" Content="Whole Model" Style="{StaticResource ScopeRadioButton}" Checked="RbScope_Checked"/>
                        <RadioButton x:Name="RbScopeSelection" Content="Current Selection" Style="{StaticResource ScopeRadioButton}" Checked="RbScope_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Refresh Button -->
                <Button Grid.Column="1" x:Name="BtnRefresh" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="10,0,0,0" Click="BtnRefresh_Click" ToolTip="Reload rebars from Revit model">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>

                <!-- Search Input Box -->
                <Grid Grid.Column="2" Margin="16,0">
                    <TextBox x:Name="TxtSearch" Height="34" Padding="32,0,24,0" TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="Search Partition name, Rebar type, Host category, Rebar Sets..." Foreground="#94A3B8" VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"/>
                    <Button x:Name="BtnClearSearch" Content="✕" Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,8,0" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Click="BtnClearSearch_Click" Visibility="Collapsed"/>
                </Grid>

                <!-- Table View Mode Selector -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="View:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbViewMode" Width="190" Height="34" SelectionChanged="CmbViewMode_SelectionChanged">
                        <ComboBoxItem Content="By Partition &amp; Type" IsSelected="True"/>
                        <ComboBoxItem Content="All Rebar Elements"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. MAIN BODY (Sidebar + Table) -->
        <Grid Grid.Row="3" Margin="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/> <!-- Left: Partition Groups Filter -->
                <ColumnDefinition Width="12"/>  <!-- Spacing -->
                <ColumnDefinition Width="*"/>   <!-- Right: Data Table -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Partition Groups -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Select All -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Partition List -->
                        <RowDefinition Height="Auto"/> <!-- All Partitions Reset -->
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Partitions" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <Border x:Name="BadgePartitionCount" Background="#E2E8F0" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                <TextBlock x:Name="TxtBadgePartitions" Text="0" FontSize="10" FontWeight="Bold" Foreground="#475569"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="All" Foreground="#0D6EFD" FontWeight="SemiBold" Cursor="Hand" MouseDown="SelectAllPartitions_Click" Margin="0,0,8,0"/>
                            <TextBlock Text="|" Foreground="#CBD5E1" Margin="0,0,8,0"/>
                            <TextBlock Text="None" Foreground="#64748B" FontWeight="SemiBold" Cursor="Hand" MouseDown="DeselectAllPartitions_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Partition List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="IcPartitions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding MediumColorBrush}" 
                                            BorderBrush="{Binding BorderColorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8" 
                                            Padding="8,6" 
                                            Margin="0,0,0,6" 
                                            Cursor="Hand" 
                                            MouseDown="PartitionItem_MouseDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#0D6EFD"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                                <ColumnDefinition Width="Auto"/> <!-- Solid Color Accent Strip -->
                                                <ColumnDefinition Width="*"/>    <!-- Partition Name & Stats -->
                                                <ColumnDefinition Width="Auto"/> <!-- Count Badge -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox to check all rebars in this partition -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" Click="PartitionCheckBox_Click"/>

                                            <!-- Solid Color Accent Strip -->
                                            <Border Grid.Column="1" Width="4" Height="26" CornerRadius="2" Background="{Binding ColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding PartitionName}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis" ToolTip="{Binding PartitionName}"/>
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0">
                                                    <Run Text="{Binding TotalBarQuantity}"/> <Run Text="bars • "/>
                                                    <Run Text="{Binding TotalLengthM}"/> <Run Text="m • "/>
                                                    <Run Text="{Binding TotalWeightKg}"/> <Run Text="kg"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Items Count Badge -->
                                            <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="{Binding BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} sets'}" FontSize="10" FontWeight="Bold" Foreground="#1E293B"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Filter Clear / All View Button -->
                    <Button Grid.Row="2" x:Name="BtnShowAllPartitions" Style="{StaticResource OutlineButton}" Padding="8,6" Margin="0,8,0,0" Click="BtnShowAllPartitions_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Show All Partitions"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: Rebar Data Grid -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Table Subtitle & Actions -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Table Header Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTableTitle" Text="Rebar Elements Grouped by Partition &amp; Type" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                            <TextBlock x:Name="TxtTableFilterStatus" Text="" Foreground="#0D6EFD" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Select All" Foreground="#0D6EFD" FontWeight="SemiBold" Cursor="Hand" MouseDown="TableSelectAll_Click" Margin="0,0,10,0"/>
                            <TextBlock Text="|" Foreground="#CBD5E1" Margin="0,0,10,0"/>
                            <TextBlock Text="Clear Selection" Foreground="#64748B" FontWeight="SemiBold" Cursor="Hand" MouseDown="TableClearSelection_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 1. GROUPED DATA GRID (Partition + Type - matches Picture 1) -->
                    <DataGrid x:Name="DgGrouped" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                              RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                              SelectionMode="Extended" CanUserSortColumns="True"
                              RowHeight="36" FontSize="12">
                        <DataGrid.Resources>
                            <!-- Header Style -->
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                            <!-- Cell Style -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Checkbox Column -->
                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="ChkHeaderGrouped" HorizontalAlignment="Center" Click="ChkHeaderGrouped_Click"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="RowCheckBox_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Color indicator -->
                            <DataGridTemplateColumn Header="" Width="20">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="{Binding ColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Partition Name -->
                            <DataGridTemplateColumn Header="Parameter Value (Partition)" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Partition}" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Partition}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Type Name -->
                            <DataGridTemplateColumn Header="Type Name" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding TypeName}" FontWeight="Bold" Foreground="#0D6EFD"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Category -->
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="120" Foreground="#475569"/>

                            <!-- Host Category -->
                            <DataGridTextColumn Header="Host Category" Binding="{Binding HostCategory}" Width="130" Foreground="#475569"/>

                            <!-- Count (Modeled Sets) -->
                            <DataGridTemplateColumn Header="Count" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" FontWeight="Bold" Foreground="#334155"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Rebar Sets Multiplier Parameter -->
                            <DataGridTemplateColumn Header="Rebar Sets" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" ToolTip="Multiplier from 'Rebar Sets' parameter">
                                            <TextBlock Text="{Binding RebarSetsDisplay, StringFormat='{}{0} Sets'}" FontWeight="Bold" Foreground="#2563EB"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Total Bar Quantity (multiplied by Rebar Sets) -->
                            <DataGridTextColumn Header="Total Bars" Binding="{Binding BarQuantity}" Width="80"/>

                            <!-- Diameter -->
                            <DataGridTemplateColumn Header="Diameter" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DiameterMm, StringFormat='{}Ø{0} mm'}" Foreground="#334155"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Total Length (multiplied by Rebar Sets) -->
                            <DataGridTemplateColumn Header="Length (m)" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalLengthM, StringFormat='{}{0:N1} m'}" Foreground="#334155"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Est Weight (multiplied by Rebar Sets) -->
                            <DataGridTemplateColumn Header="Weight (kg)" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalWeightKg, StringFormat='{}{0:N1} kg'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 2. DETAILED INDIVIDUAL ELEMENTS DATA GRID -->
                    <DataGrid x:Name="DgDetailed" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                              RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                              SelectionMode="Extended" CanUserSortColumns="True"
                              RowHeight="36" FontSize="12" Visibility="Collapsed">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Checkbox Column -->
                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="ChkHeaderDetailed" HorizontalAlignment="Center" Click="ChkHeaderDetailed_Click"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="DetailedCheckBox_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Color indicator -->
                            <DataGridTemplateColumn Header="" Width="20">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="{Binding ColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Rebar ID" Binding="{Binding RebarId}" Width="80" Foreground="#64748B"/>
                            <DataGridTextColumn Header="Partition" Binding="{Binding Partition}" Width="190" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Type Name" Binding="{Binding TypeName}" Width="100"/>
                            <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="160"/>
                            <DataGridTextColumn Header="Host Category" Binding="{Binding HostCategory}" Width="120"/>
                            <DataGridTextColumn Header="Shape" Binding="{Binding ShapeName}" Width="75"/>
                            <DataGridTextColumn Header="Single Qty" Binding="{Binding SingleQuantity}" Width="70"/>
                            <DataGridTemplateColumn Header="Rebar Sets" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="4,1" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding RebarSets, StringFormat='{}{0} Sets'}" FontWeight="Bold" Foreground="#2563EB"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Total Bars" Binding="{Binding Quantity}" Width="75" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Diameter" Binding="{Binding DiameterMm, StringFormat='{}Ø{0} mm'}" Width="80"/>
                            <DataGridTextColumn Header="Length (m)" Binding="{Binding TotalLengthM, StringFormat='{}{0:N2} m'}" Width="85"/>
                            <DataGridTextColumn Header="Weight (kg)" Binding="{Binding WeightKg, StringFormat='{}{0:N2} kg'}" Width="85" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Mark" Binding="{Binding ScheduleMark}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </Border>
        </Grid>

        <!-- 5. BOTTOM ACTION BAR -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Branding / Status -->
                    <ColumnDefinition Width="*"/>    <!-- Spacing -->
                    <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                </Grid.ColumnDefinitions>

                <!-- Left: Branding & Status -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock x:Name="TxtStatus" Text="Ready: 0 elements selected" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="Better Design • Smarter BIM • BIMPlus+" FontSize="10" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Set Rebar Sets Multiplier Button -->
                    <Button x:Name="BtnSetRebarSets" Style="{StaticResource OutlineButton}" Padding="12,8" Margin="0,0,8,0" Click="BtnSetRebarSets_Click" ToolTip="Set 'Rebar Sets' multiplier for checked rebars">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔢" Margin="0,0,6,0"/>
                            <TextBlock Text="Set Rebar Sets..."/>
                        </StackPanel>
                    </Button>

                    <!-- Assign/Rename Partition Button -->
                    <Button x:Name="BtnAssignPartition" Style="{StaticResource OutlineButton}" Padding="12,8" Margin="0,0,8,0" Click="BtnAssignPartition_Click" ToolTip="Set or rename Partition for checked rebars">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️" Margin="0,0,6,0"/>
                            <TextBlock Text="Set Partition..."/>
                        </StackPanel>
                    </Button>

                    <!-- Export CSV Button -->
                    <Button x:Name="BtnExportCsv" Style="{StaticResource OutlineButton}" Padding="12,8" Margin="0,0,8,0" Click="BtnExportCsv_Click" ToolTip="Export current table to CSV file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥" Margin="0,0,6,0"/>
                            <TextBlock Text="Export CSV"/>
                        </StackPanel>
                    </Button>

                    <!-- Colorize Partitions Button -->
                    <Button x:Name="BtnColorize" Style="{StaticResource OutlineButton}" Padding="12,8" Margin="0,0,8,0" Click="BtnColorize_Click" ToolTip="Assign unique colors to each partition in 3D view">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎨" Margin="0,0,6,0"/>
                            <TextBlock Text="Colorize Partitions"/>
                        </StackPanel>
                    </Button>

                    <!-- Reset Colors Button -->
                    <Button x:Name="BtnResetColors" Style="{StaticResource OutlineButton}" Padding="10,8" Margin="0,0,8,0" Click="BtnResetColors_Click" ToolTip="Remove color overrides from rebar elements">
                        <TextBlock Text="Clear Colors"/>
                    </Button>

                    <!-- Reset View Isolate Button -->
                    <Button x:Name="BtnResetView" Style="{StaticResource OutlineButton}" Padding="10,8" Margin="0,0,8,0" Click="BtnResetView_Click" ToolTip="Reset temporary view isolation">
                        <TextBlock Text="Reset View"/>
                    </Button>

                    <!-- Isolate Selection Button -->
                    <Button x:Name="BtnIsolateSelection" Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,10,0" Click="BtnIsolateSelection_Click" ToolTip="Isolate checked rebars in current active view">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁️" Margin="0,0,6,0"/>
                            <TextBlock Text="Isolate Selection" FontWeight="Bold" Foreground="#0D6EFD"/>
                        </StackPanel>
                    </Button>

                    <!-- Primary: SELECT IN REVIT Button -->
                    <Button x:Name="BtnSelectInRevit" Style="{StaticResource ModernButton}" Background="#0D6EFD" Padding="20,10" Click="BtnSelectInRevit_Click" ToolTip="Select checked rebar elements in Revit model">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="SELECT IN REVIT" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
