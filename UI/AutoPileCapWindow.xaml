<Window x:Class="AutoPileCap.UI.AutoPileCapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Pile Cap Generator - BIM Plus⁺"
        Height="720" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="13">

    <Window.Resources>
        <!-- Modern Light Theme Styles -->
        <SolidColorBrush x:Key="PrimaryAccent" Color="#0D6EFD"/>
        <SolidColorBrush x:Key="PrimaryAccentHover" Color="#0B5ED7"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="InputBackground" Color="#F1F5F9"/>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <StackPanel Margin="16">
                                <ContentPresenter ContentSource="Header" Margin="0,0,0,12"/>
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Action / Status Bar -->
        </Grid.RowDefinitions>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
            <StackPanel Orientation="Vertical">

                <!-- Selection Scope Card -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="1. Column Target Scope" Foreground="#0D6EFD" FontWeight="Bold"/>
                    </GroupBox.Header>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="RbSelectedColumns" Content="Selected Columns in Model" IsChecked="True" Grid.Column="0"/>
                        <RadioButton x:Name="RbAllColumns" Content="All Columns in Active View" Grid.Column="1"/>
                    </Grid>
                </GroupBox>

                <!-- Pile Layout Pattern Card -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="2. Pile Cap Configuration" Foreground="#0D6EFD" FontWeight="Bold"/>
                    </GroupBox.Header>
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pile Count -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Pile Layout / Quantity:"/>
                        <ComboBox x:Name="CmbPileCount" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" SelectionChanged="CmbPileCount_SelectionChanged">
                            <ComboBoxItem Content="1 Pile - Centric" Tag="1"/>
                            <ComboBoxItem Content="2 Piles - Linear" Tag="2"/>
                            <ComboBoxItem Content="3 Piles - Triangular" Tag="3"/>
                            <ComboBoxItem Content="4 Piles - Square (2x2)" Tag="4" IsSelected="True"/>
                            <ComboBoxItem Content="5 Piles - Quincunx" Tag="5"/>
                            <ComboBoxItem Content="6 Piles - Rectangular (2x3)" Tag="6"/>
                            <ComboBoxItem Content="8 Piles - Perimeter (3x3)" Tag="8"/>
                            <ComboBoxItem Content="9 Piles - Full Grid (3x3)" Tag="9"/>
                        </ComboBox>

                        <!-- Pile Diameter -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Pile Diameter (D):"/>
                        <TextBox x:Name="TxtPileDiameter" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="400" TextChanged="Parameters_Changed"/>
                        <Label Grid.Row="1" Grid.Column="2" Content="mm" Foreground="{StaticResource TextMuted}"/>

                        <!-- Pile Spacing -->
                        <Label Grid.Row="2" Grid.Column="0" Content="Pile Center-to-Center:"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4">
                            <RadioButton x:Name="RbSpacing3D" Content="3.0 x D" IsChecked="True" Margin="0,0,16,0" Checked="SpacingRadio_Checked"/>
                            <RadioButton x:Name="RbSpacing25D" Content="2.5 x D" Margin="0,0,16,0" Checked="SpacingRadio_Checked"/>
                            <RadioButton x:Name="RbSpacingCustom" Content="Custom:" Margin="0,0,8,0" Checked="SpacingRadio_Checked"/>
                            <TextBox x:Name="TxtCustomSpacing" Width="80" Text="1200" IsEnabled="False" TextChanged="Parameters_Changed"/>
                            <Label Content="mm" Foreground="{StaticResource TextMuted}" Margin="4,0,0,0"/>
                        </StackPanel>

                        <!-- Edge Distance -->
                        <Label Grid.Row="3" Grid.Column="0" Content="Cap Overhang / Edge (e):"/>
                        <TextBox x:Name="TxtEdgeDistance" Grid.Row="3" Grid.Column="1" Margin="0,4" Text="250" TextChanged="Parameters_Changed"/>
                        <Label Grid.Row="3" Grid.Column="2" Content="mm" Foreground="{StaticResource TextMuted}"/>

                        <!-- Cap Thickness -->
                        <Label Grid.Row="4" Grid.Column="0" Content="Cap Thickness / Depth:"/>
                        <TextBox x:Name="TxtCapThickness" Grid.Row="4" Grid.Column="1" Margin="0,4" Text="800" TextChanged="Parameters_Changed"/>
                        <Label Grid.Row="4" Grid.Column="2" Content="mm" Foreground="{StaticResource TextMuted}"/>
                    </Grid>
                </GroupBox>

                <!-- Calculated Dimensions Preview -->
                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📐 Est. Cap Size:" FontWeight="Bold" Foreground="#0D6EFD" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCalculatedDimensions" Grid.Column="1" Text="Width: 1700 mm x Length: 1700 mm | Thickness: 800 mm" 
                                   Foreground="#475569" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Family Symbols Selection Card -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="3. Revit Family Symbols" Foreground="#0D6EFD" FontWeight="Bold"/>
                    </GroupBox.Header>
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pile Cap Symbol -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Pile Cap Foundation:"/>
                        <ComboBox x:Name="CmbCapSymbol" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>

                        <!-- Place Piles Option -->
                        <CheckBox x:Name="ChkCreatePiles" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
                                  Content="Also generate and place individual piles under the cap" 
                                  IsChecked="True" Margin="0,8,0,8" Checked="ChkCreatePiles_Changed" Unchecked="ChkCreatePiles_Changed"/>

                        <!-- Pile Symbol -->
                        <Label x:Name="LblPileSymbol" Grid.Row="2" Grid.Column="0" Content="Pile Foundation Type:"/>
                        <ComboBox x:Name="CmbPileSymbol" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>

                        <!-- Pile Length -->
                        <Label x:Name="LblPileLength" Grid.Row="3" Grid.Column="0" Content="Pile Embedded Length:"/>
                        <TextBox x:Name="TxtPileLength" Grid.Row="3" Grid.Column="1" Margin="0,4" Text="12.0"/>
                        <Label x:Name="LblPileLengthUnit" Grid.Row="3" Grid.Column="2" Content="meters" Foreground="{StaticResource TextMuted}"/>
                    </Grid>
                </GroupBox>

                <!-- Elevation and Alignment Card -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="4. Placement &amp; Alignment" Foreground="#0D6EFD" FontWeight="Bold"/>
                    </GroupBox.Header>
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="ChkAlignRotation" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                  Content="Rotate pile cap and piles to match column orientation" IsChecked="True" Margin="0,4,0,10"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Base Level:"/>
                        <ComboBox x:Name="CmbLevels" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Level Elevation Offset:"/>
                        <TextBox x:Name="TxtLevelOffset" Grid.Row="2" Grid.Column="1" Margin="0,4" Text="0"/>
                        <Label Grid.Row="2" Grid.Column="2" Content="mm" Foreground="{StaticResource TextMuted}"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Action Area -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,16,14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnGenerate" Grid.Column="0" Content="⚡ GENERATE PILE CAPS" 
                        Height="44" Margin="0,0,12,0"
                        Background="#0D6EFD" Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand"
                        Click="BtnGenerate_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnClose" Grid.Column="1" Content="CLOSE" 
                        Width="100" Height="44"
                        Background="#FFFFFF" Foreground="#0F172A" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnClose_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
            
            <Grid Margin="0,12,0,0">
                <TextBlock x:Name="TxtStatus" Text="Ready to generate pile caps" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                <ProgressBar x:Name="PrgProgress" Height="4" Visibility="Collapsed" Background="#F1F5F9" Foreground="#0D6EFD"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
