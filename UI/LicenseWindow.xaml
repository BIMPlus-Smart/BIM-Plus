<Window x:Class="AutoPileCap.UI.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Plus⁺ — Product Activation" 
        Width="520" Height="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, -apple-system, Arial"
        FontSize="13"
        Topmost="True">

    <Window.Resources>
        <!-- Modern Color Palette -->
        <SolidColorBrush x:Key="BrandPrimary" Color="#0D6EFD"/>
        <SolidColorBrush x:Key="BrandPrimaryHover" Color="#0B5ED7"/>
        <SolidColorBrush x:Key="BrandPrimaryPressed" Color="#0A58CA"/>
        
        <SolidColorBrush x:Key="DarkHeaderBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="WindowBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBorderFocus" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="TextDim" Color="#94A3B8"/>

        <!-- Modern Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#1D4ED8" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.2" Color="#1E40AF"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1D4ED8" Offset="0"/>
                                            <GradientStop Color="#1E40AF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outline Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Action Pill Button Style -->
        <Style x:Key="PillActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#BFDBFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Modern Hero Header -->
            <RowDefinition Height="Auto"/> <!-- Main Form Content -->
            <RowDefinition Height="Auto"/> <!-- Bottom Action Bar -->
        </Grid.RowDefinitions>

        <!-- 1. MODERN HERO HEADER BANNER -->
        <Border Grid.Row="0" Background="{StaticResource DarkHeaderBg}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Glowing Product Icon -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#1D4ED8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.35" Color="#3B82F6"/>
                    </Border.Effect>
                    <!-- Key / Shield Vector Icon -->
                    <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                          Fill="White" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- App Title & Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="BIM" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                        <TextBlock Text="Plus" FontSize="20" FontWeight="Black" Foreground="#60A5FA"/>
                        <TextBlock Text="⁺" FontSize="20" FontWeight="Black" Foreground="#60A5FA"/>
                    </StackPanel>
                    <TextBlock Text="Product Activation &amp; Licensing" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- License Status Pill -->
                <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,6,0"/>
                        <TextBlock Text="ACTIVATION REQUIRED" FontSize="10" FontWeight="Bold" Foreground="#FCD34D" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. MAIN FORM CONTENT -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="24,18,24,16">
            
            <!-- Instruction Callout -->
            <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Info Icon -->
                    <Path Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                          Fill="#2563EB" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock Grid.Column="1" Text="Send this Machine ID to the developer to generate your activation key." 
                               Foreground="#1E40AF" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"/>
                </Grid>
            </Border>

            <!-- SECTION 1: MACHINE ID -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="STEP 1: YOUR MACHINE ID" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Grid.Column="1" Text="Hardware Identifier" FontSize="11" Foreground="{StaticResource TextDim}"/>
            </Grid>

            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hardware Chip Icon -->
                    <Path Grid.Column="0" Data="M4 6h16v12H4zm2 2v8h12V8H6zm3-5h2v3H9V3zm4 0h2v3h-2V3zm-4 15h2v3H9v-3zm4 0h2v3h-2v-3zM1 9h3v2H1V9zm0 4h3v2H1v-2zm19-4h3v2h-3V9zm0 4h3v2h-3v-2z"
                          Fill="{StaticResource TextMuted}" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center" Margin="2,0,10,0"/>

                    <!-- Machine ID Readonly Box -->
                    <TextBox x:Name="TxtMachineId" Grid.Column="1" IsReadOnly="True" 
                             FontFamily="Consolas, Cascadia Code, Segoe UI Mono" FontSize="17" FontWeight="Bold" 
                             Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" 
                             VerticalAlignment="Center" Focusable="True"/>

                    <!-- Copy ID Pill Button -->
                    <Button x:Name="BtnCopy" Grid.Column="2" Style="{StaticResource PillActionButtonStyle}" Click="BtnCopy_Click" ToolTip="Copy Machine ID to clipboard">
                        <StackPanel Orientation="Horizontal">
                            <!-- Default Copy Icon -->
                            <Path x:Name="IconCopyDefault" Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" 
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <!-- Success Checkmark Icon -->
                            <Path x:Name="IconCopySuccess" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" 
                                  Fill="#16A34A" Stretch="Uniform" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtCopyBtnLabel" Text="Copy ID" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- SECTION 2: ACTIVATION CODE -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="STEP 2: ENTER ACTIVATION CODE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Grid.Column="1" Text="Provided by developer" FontSize="11" Foreground="{StaticResource TextDim}"/>
            </Grid>

            <Border x:Name="ActivationBorder" Background="{StaticResource CardBg}" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource CardBorderFocus}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Key Icon -->
                    <Path Grid.Column="0" Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center" Margin="2,0,10,0"/>

                    <!-- Activation Code Input Field -->
                    <Grid Grid.Column="1">
                        <!-- Placeholder Watermark Text -->
                        <TextBlock Text="Paste or type code (e.g. XXXX-XXXX-XXXX)" 
                                   Foreground="{StaticResource TextDim}" 
                                   FontFamily="Consolas, Cascadia Code, Segoe UI Mono"
                                   FontSize="15"
                                   VerticalAlignment="Center" 
                                   Margin="2,0,0,0" 
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtActivationCode}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox x:Name="TxtActivationCode"
                                 FontFamily="Consolas, Cascadia Code, Segoe UI Mono" 
                                 FontSize="16" FontWeight="Bold" 
                                 Foreground="{StaticResource TextPrimary}" 
                                 Background="Transparent" BorderThickness="0" 
                                 VerticalAlignment="Center" 
                                 Padding="2,0"
                                 CharacterCasing="Upper"
                                 TextChanged="TxtActivationCode_TextChanged"/>
                    </Grid>

                    <!-- Paste Button -->
                    <Button x:Name="BtnPaste" Grid.Column="2" Style="{StaticResource PillActionButtonStyle}" Click="BtnPaste_Click" ToolTip="Paste activation code from clipboard">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 2h-4.18C14.4 0.84 13.3 0 12 0c-1.3 0-2.4 0.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z" 
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Paste" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- STATUS / NOTIFICATION MESSAGE BANNER -->
            <Border x:Name="StatusBorder" Visibility="Collapsed" CornerRadius="6" BorderThickness="1" Padding="12,8" Margin="0,2,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Error Icon -->
                    <Path x:Name="StatusIconError" Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" 
                          Fill="#DC2626" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <!-- Success Icon -->
                    <Path x:Name="StatusIconSuccess" Grid.Column="0" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" 
                          Fill="#16A34A" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>

                    <!-- Text Error / Feedback message -->
                    <TextBlock x:Name="TxtError" Grid.Column="1" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </StackPanel>

        <!-- 3. BOTTOM ACTION BAR -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Security Note on Left -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 6h2v2h-2V7zm0 4h2v6h-2v-6z" 
                          Fill="{StaticResource TextDim}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Secure 256-Bit Offline Key" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Cancel Button -->
                    <Button Content="Cancel" Width="95" Height="38" Margin="0,0,10,0" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            IsCancel="True"
                            Click="BtnCancel_Click"/>

                    <!-- Activate Button -->
                    <Button x:Name="BtnActivate" Width="150" Height="38" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            IsDefault="True"
                            Click="BtnActivate_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Unlock / Check Icon -->
                            <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" 
                                  Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ACTIVATE" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
