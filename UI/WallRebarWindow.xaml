<Window x:Class="AutoPileCap.UI.WallRebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Plus — Wall Bar Pro (Max Spacing Fix)"
        Height="860" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="12">
    <!-- Resources -->
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#0D6EFD"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#E2E8F0"/>

        <!-- ToggleSwitch Style for CheckBoxes -->
        <Style TargetType="CheckBox" x:Key="ToggleSwitch">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Width="36" Height="20" CornerRadius="10" Background="#CBD5E1">
                            <Ellipse x:Name="thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D6EFD"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/> <!-- Header -->
            <RowDefinition Height="*"/>  <!-- Main Body -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Grid Grid.Row="0" Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo Area -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="BIM" FontSize="24" FontWeight="Black" Foreground="#0F172A"/>
                    <TextBlock Text="Plus" FontSize="24" FontWeight="Black" Foreground="#0D6EFD"/>
                    <TextBlock Text="+" FontSize="24" FontWeight="Black" Foreground="#0D6EFD" Margin="2,0,0,0"/>
                </StackPanel>
                <TextBlock Text="|" FontSize="20" Foreground="#CBD5E1" Margin="12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Wall Bar Pro" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Full 3D Reinforcement Cage Generator" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </StackPanel>

            <!-- Right Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚙ Settings" Foreground="#475569" Margin="0,0,20,0" Cursor="Hand"/>
                <TextBlock Text="? Help" Foreground="#475569" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/> <!-- Left Nav -->
                <ColumnDefinition Width="380"/> <!-- Controls -->
                <ColumnDefinition Width="*"/>   <!-- Canvas -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAV -->
            <Border Grid.Column="0" Background="#FFFFFF" Margin="10,0,10,16" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <StackPanel Margin="0,20,0,0">
                        <Button x:Name="NavViewSection" Content="Section" Height="40" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Margin="8,4" Tag="SECTION" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="NavView3D" Content="3D View" Height="40" Background="#0D6EFD" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="8,4" Tag="3D" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="NavViewTop" Content="Top View" Height="40" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Margin="8,4" Tag="TOP" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="NavViewBot" Content="Bot View" Height="40" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Margin="8,4" Tag="BOT" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,20">
                        <TextBlock Text="Better Design" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="Smarter BIM" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="BIM" FontSize="12" FontWeight="Black" Foreground="#0F172A"/>
                            <TextBlock Text="Plus+" FontSize="12" FontWeight="Black" Foreground="#0D6EFD"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTROLS PANEL -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="16" Margin="0,0,16,16" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Wall selector -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Wall:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <TextBlock x:Name="TxtWallName" Text="None" Foreground="#0F172A" VerticalAlignment="Center" Padding="10,0"/>
                        </Border>
                        <Button x:Name="BtnSelectWall" Grid.Column="2" Content="⌖ Pick Element" Background="#0D6EFD" Foreground="White" Width="100" Height="32" Click="BtnSelectWall_Click" FontWeight="Bold" BorderThickness="0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Scroll Form -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            
                            <!-- 1 Vertical Rebar -->
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#0D6EFD">
                                            <TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Vertical Rebar" Foreground="#0F172A" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="10,0"/>
                                        <CheckBox x:Name="ChkEnableTop" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" Checked="Inputs_Changed" Unchecked="Inputs_Changed"/>
                                    </Grid>
                                    
                                    <Grid x:Name="PanelTop">
                                        <StackPanel Margin="0,0,8,0">
                                            <Label Content="Type"/>
                                            <ComboBox x:Name="CmbTopTypeX" SelectionChanged="Inputs_Changed" Margin="0,0,0,8"/>
                                            <Label Content="Hook (mm)"/>
                                            <TextBox x:Name="TxtTopHookX" Text="400" TextChanged="Inputs_Changed" Margin="0,0,0,8"/>
                                            <Label Content="Spacing (mm)"/>
                                            <TextBox x:Name="TxtTopSpacingX" Text="150" TextChanged="Inputs_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2 Horizontal Rebar -->
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#0D6EFD">
                                            <TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Horizontal Rebar" Foreground="#0F172A" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="10,0"/>
                                        <CheckBox x:Name="ChkEnableBot" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" Checked="Inputs_Changed" Unchecked="Inputs_Changed"/>
                                    </Grid>
                                    
                                    <Grid x:Name="PanelBot">
                                        <StackPanel Margin="0,0,8,0">
                                            <Label Content="Type"/>
                                            <ComboBox x:Name="CmbBotTypeX" SelectionChanged="Inputs_Changed" Margin="0,0,0,8"/>
                                            <Label Content="Hook (mm)"/>
                                            <TextBox x:Name="TxtBotHookX" Text="450" TextChanged="Inputs_Changed" Margin="0,0,0,8"/>
                                            <Label Content="Spacing (mm)"/>
                                            <TextBox x:Name="TxtBotSpacingX" Text="150" TextChanged="Inputs_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3 Pin bar -->
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#0D6EFD">
                                            <TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Pin bar" Foreground="#0F172A" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="10,0"/>
                                        <CheckBox x:Name="ChkEnableSide" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" Checked="Inputs_Changed" Unchecked="Inputs_Changed"/>
                                    </Grid>
                                    
                                    <Grid x:Name="PanelSide">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Type"/>
                                            <ComboBox x:Name="CmbSideType" SelectionChanged="Inputs_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                            <Label Content="Shape"/>
                                            <ComboBox x:Name="CmbSideShape" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Inputs_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <Label Content="Spacing (mm)"/>
                                            <TextBox x:Name="TxtSideSpacing" Text="150" TextChanged="Inputs_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnViewAll" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtStatus" Visibility="Collapsed"/>
                            <ProgressBar x:Name="PrgBar" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button x:Name="BtnGenerate" Content="⚙ GENERATE >" 
                                Height="48" Background="#0D6EFD" Foreground="White" FontSize="16" FontWeight="Bold" Cursor="Hand"
                                Click="BtnGenerate_Click" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CANVAS AREA -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="16" Margin="0,0,16,16" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Canvas Buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" HorizontalAlignment="Left">
                        <Button x:Name="BtnView3D" Content="3D VIEW" Width="100" Height="36" Background="#0D6EFD" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Tag="3D" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnViewTop" Content="TOP VIEW" Width="100" Height="36" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Tag="TOP" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnViewBot" Content="BOT VIEW" Width="100" Height="36" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Tag="BOT" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnViewSection" Content="SECTION" Width="100" Height="36" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Tag="SECTION" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Canvas -->
                    <Border Grid.Row="1" ClipToBounds="True" x:Name="CanvasBorder" Background="#FFFFFF"
                            MouseWheel="Canvas_MouseWheel"
                            MouseDown="Canvas_MouseDown"
                            MouseMove="Canvas_MouseMove"
                            MouseUp="Canvas_MouseUp"
                            MouseRightButtonDown="Canvas_MouseRightButtonDown"
                            SizeChanged="CanvasBorder_SizeChanged">
                        <Canvas x:Name="PreviewCanvas" Width="1400" Height="1000" Background="#FFFFFF">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CanvasScale" ScaleX="1.0" ScaleY="1.0"/>
                                    <TranslateTransform x:Name="CanvasTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Border>

                    <!-- Bottom Panels -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Reinforcement Summary -->
                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,8,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Reinforcement Summary" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#F59E0B" Height="4" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Vertical Rebar" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtSumTop" Grid.Column="2" Text="DB14 @150mm (Hook 400mm)" Foreground="#0F172A" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#0D6EFD" Height="4" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Horizontal Rebar" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtSumBot" Grid.Column="2" Text="DB16 @150mm (Hook 450mm)" Foreground="#0F172A" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#06B6D4" Height="4" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Pin bar" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtSumSide" Grid.Column="2" Text="DB14 @150mm" Foreground="#0F172A" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Drawing Information -->
                        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="8,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Drawing Information" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBlock Text="Covers" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtDrawingCovers" Text="Top: 50mm | Bot: 100mm | Side: 62mm" Foreground="#0F172A"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                    <TextBlock Text="↕ Unit mm" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>









