<Window x:Class="AutoPileCap.UI.StairRebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Plus — Stair Bar Pro"
        Height="860" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, Arial"
        FontSize="12">
    <!-- Resources -->
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#0D6EFD"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#E2E8F0"/>

        <!-- ToggleSwitch Style for CheckBoxes -->
        <Style TargetType="CheckBox" x:Key="ToggleSwitch">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Width="36" Height="20" CornerRadius="10" Background="#CBD5E1">
                            <Ellipse x:Name="thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D6EFD"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Padding" Value="0,4,0,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/> <!-- Header -->
            <RowDefinition Height="*"/>  <!-- Main Body -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Grid Grid.Row="0" Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo Area -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="BIM" FontSize="24" FontWeight="Black" Foreground="#0F172A"/>
                    <TextBlock Text="Plus" FontSize="24" FontWeight="Black" Foreground="#0D6EFD"/>
                    <TextBlock Text="+" FontSize="24" FontWeight="Black" Foreground="#0D6EFD" Margin="2,0,0,0"/>
                </StackPanel>
                <TextBlock Text="|" FontSize="20" Foreground="#CBD5E1" Margin="12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Stair Bar Pro" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Full 3D Reinforcement Cage Generator (Waist, Scissor &amp; Distribution)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </StackPanel>

            <!-- Right Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚙ Settings" Foreground="#475569" Margin="0,0,20,0" Cursor="Hand"/>
                <TextBlock Text="? Help" Foreground="#475569" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/> <!-- Left Nav -->
                <ColumnDefinition Width="400"/> <!-- Controls -->
                <ColumnDefinition Width="*"/>   <!-- Canvas -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAV -->
            <Border Grid.Column="0" Background="#FFFFFF" Margin="10,0,10,16" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <StackPanel Margin="0,20,0,0">
                        <Button x:Name="NavViewSection" Content="Section" Height="40" Background="#0D6EFD" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="8,4" Tag="SECTION" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="NavView3D" Content="3D View" Height="40" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Margin="8,4" Tag="3D" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="NavViewTop" Content="Plan View" Height="40" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Margin="8,4" Tag="TOP" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="NavViewBot" Content="Bot View" Height="40" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Margin="8,4" Tag="BOT" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,20">
                        <TextBlock Text="Better Design" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="Smarter BIM" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="BIM" FontSize="12" FontWeight="Black" Foreground="#0F172A"/>
                            <TextBlock Text="Plus+" FontSize="12" FontWeight="Black" Foreground="#0D6EFD"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTROLS PANEL -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="16" Margin="0,0,16,16" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Stair selector -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Stair:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <TextBlock x:Name="TxtStairName" Text="None" Foreground="#0F172A" VerticalAlignment="Center" Padding="10,0" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button x:Name="BtnSelectStair" Grid.Column="2" Content="⌖ Pick Stair" Background="#0D6EFD" Foreground="White" Width="95" Height="32" Click="BtnSelectStair_Click" FontWeight="Bold" BorderThickness="0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Scroll Form -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">

                            <!-- 1 Bottom Rebar -->
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#0D6EFD">
                                            <TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Bottom Rebar (Waist Bars)" Foreground="#0F172A" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0"/>
                                        <CheckBox x:Name="ChkEnableBot" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" Checked="Inputs_Changed" Unchecked="Inputs_Changed"/>
                                    </Grid>

                                    <Grid x:Name="PanelBot">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Bar Type"/>
                                            <ComboBox x:Name="CmbBotType" SelectionChanged="Inputs_Changed" Margin="0,0,0,6"/>
                                            <Label Content="Spacing (mm)"/>
                                            <TextBox x:Name="TxtBotSpacing" Text="150" TextChanged="Inputs_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <Label Content="Anchor Bot (mm)"/>
                                            <TextBox x:Name="TxtBotAnchorBot" Text="500" TextChanged="Inputs_Changed" Margin="0,0,0,6"/>
                                            <Label Content="Anchor Top (mm)"/>
                                            <TextBox x:Name="TxtBotAnchorTop" Text="500" TextChanged="Inputs_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="ChkBotHook" Content="90° Hook Upward at Lower Landing" Margin="0,8,0,0" IsChecked="True" Checked="Inputs_Changed" Unchecked="Inputs_Changed" Foreground="#475569" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- 2 Top Rebar (Scissor Detail) -->
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#F59E0B">
                                            <TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Top Rebar &amp; Scissor Detail" Foreground="#0F172A" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0"/>
                                        <CheckBox x:Name="ChkEnableTop" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" Checked="Inputs_Changed" Unchecked="Inputs_Changed"/>
                                    </Grid>

                                    <Grid x:Name="PanelTop">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Bar Type"/>
                                            <ComboBox x:Name="CmbTopType" SelectionChanged="Inputs_Changed" Margin="0,0,0,6"/>
                                            <Label Content="Spacing (mm)"/>
                                            <TextBox x:Name="TxtTopSpacing" Text="150" TextChanged="Inputs_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <Label Content="Scissor Lap (mm)"/>
                                            <TextBox x:Name="TxtTopScissorLap" Text="650" TextChanged="Inputs_Changed" Margin="0,0,0,6"/>
                                            <Label Content="Anchor Top (mm)"/>
                                            <TextBox x:Name="TxtTopAnchorTop" Text="600" TextChanged="Inputs_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="ChkTopHook" Content="90° Hook Downward at Upper Landing" Margin="0,8,0,0" IsChecked="True" Checked="Inputs_Changed" Unchecked="Inputs_Changed" Foreground="#475569" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- 3 Transverse / Distribution Rebar -->
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#10B981">
                                            <TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Distribution Bars (Transverse)" Foreground="#0F172A" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0"/>
                                        <CheckBox x:Name="ChkEnableDist" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True" Checked="Inputs_Changed" Unchecked="Inputs_Changed"/>
                                    </Grid>

                                    <Grid x:Name="PanelDist">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Bar Type"/>
                                            <ComboBox x:Name="CmbDistType" SelectionChanged="Inputs_Changed" Margin="0,0,0,6"/>
                                            <Label Content="Waist Spacing (mm)"/>
                                            <TextBox x:Name="TxtDistSpacing" Text="200" TextChanged="Inputs_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <Label Content="Landing Spacing (mm)"/>
                                            <TextBox x:Name="TxtLandingSpacing" Text="200" TextChanged="Inputs_Changed" Margin="0,0,0,6"/>
                                            <CheckBox x:Name="ChkTopDist" Content="Top Mat Distribution" Margin="0,24,0,0" IsChecked="True" Checked="Inputs_Changed" Unchecked="Inputs_Changed" Foreground="#475569" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4 Covers & Geometry -->
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#64748B">
                                            <TextBlock Text="4" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Covers &amp; Geometry" Foreground="#0F172A" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Waist Cover (mm)"/>
                                            <TextBox x:Name="TxtCoverWaist" Text="30" TextChanged="Inputs_Changed" Margin="0,0,0,6"/>
                                            <Label Content="Side Cover (mm)"/>
                                            <TextBox x:Name="TxtCoverSide" Text="30" TextChanged="Inputs_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <Label Content="Top Cover (mm)"/>
                                            <TextBox x:Name="TxtCoverTop" Text="30" TextChanged="Inputs_Changed" Margin="0,0,0,6"/>
                                            <Label Content="Waist Thickness (mm)"/>
                                            <TextBox x:Name="TxtWaistThick" Text="160" TextChanged="Inputs_Changed"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="Partition Name"/>
                                            <TextBox x:Name="TxtPartition" Text="Stair" TextChanged="Inputs_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <CheckBox x:Name="ChkViewSolid" Content="View as 3D Solid" Margin="0,22,0,0" IsChecked="True" Foreground="#475569" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtStatus" Visibility="Collapsed" Foreground="#DC2626" Margin="0,4"/>
                            <ProgressBar x:Name="PrgBar" Visibility="Collapsed" Height="4" IsIndeterminate="True" Margin="0,4"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Generate Button -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button x:Name="BtnGenerate" Content="⚙ GENERATE STAIR REBAR >" 
                                Height="48" Background="#0D6EFD" Foreground="White" FontSize="15" FontWeight="Bold" Cursor="Hand"
                                Click="BtnGenerate_Click" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CANVAS AREA -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="16" Margin="0,0,16,16" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Canvas Buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Left">
                        <Button x:Name="BtnViewSection" Content="SECTION" Width="100" Height="36" Background="#0D6EFD" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Tag="SECTION" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnView3D" Content="3D VIEW" Width="100" Height="36" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Tag="3D" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnViewTop" Content="PLAN VIEW" Width="100" Height="36" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Tag="TOP" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnViewBot" Content="BOT VIEW" Width="100" Height="36" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Bold" BorderThickness="0" Tag="BOT" Click="BtnViewMode_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Canvas -->
                    <Border Grid.Row="1" ClipToBounds="True" x:Name="CanvasBorder" Background="#FFFFFF"
                            MouseWheel="Canvas_MouseWheel"
                            MouseDown="Canvas_MouseDown"
                            MouseMove="Canvas_MouseMove"
                            MouseUp="Canvas_MouseUp"
                            MouseRightButtonDown="Canvas_MouseRightButtonDown"
                            SizeChanged="CanvasBorder_SizeChanged">
                        <Canvas x:Name="PreviewCanvas" Width="1400" Height="1000" Background="#FFFFFF">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CanvasScale" ScaleX="1.0" ScaleY="1.0"/>
                                    <TranslateTransform x:Name="CanvasTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Border>

                    <!-- Bottom Summary Panels -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Reinforcement Summary -->
                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="14" Margin="0,0,6,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Reinforcement Summary" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Grid x:Name="GridSumBot" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#0D6EFD" Height="4" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="Bottom Rebar" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="TxtSumBot" Grid.Column="2" Text="T12 @150mm (Anchor 500mm)" Foreground="#0F172A" FontSize="11" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid x:Name="GridSumTop" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#F59E0B" Height="4" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="Top Scissor" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="TxtSumTop" Grid.Column="2" Text="T12 @150mm (Lap 650mm)" Foreground="#0F172A" FontSize="11" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid x:Name="GridSumDist" Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#10B981" Height="4" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="Distribution" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="TxtSumDist" Grid.Column="2" Text="T10 @200mm" Foreground="#0F172A" FontSize="11" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Drawing Information -->
                        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="12" Padding="14" Margin="6,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Drawing Information" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Dimensions &amp; Covers" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtDrawingInfo" Text="Waist: 160mm | Width: 1000mm | Covers: 30mm" Foreground="#0F172A" FontSize="11"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <TextBlock Text="↕ Unit: mm | Standard ACI / BS Detail" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
